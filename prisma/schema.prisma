generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  analyses  Analysis[]
}

model Analysis {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  brandOrKeyword       String
  domain               String?
  competitors          String[]
  status               String                @default("pending")
  progress             Int                   @default(0)
  currentStep          String?
  createdAt            DateTime              @default(now())
  completedAt          DateTime?
  discoveredQuestions  DiscoveredQuestion[]
  aiTestResults        AITestResult[]
  detectedCompetitors  DetectedCompetitor[]
  aiInsights           AIInsight[]

  @@index([userId])
  @@index([status])
  @@map("analyses")
}

model DiscoveredQuestion {
  id           String   @id @default(cuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  question     String
  searchVolume Int
  difficulty   Int
  intent       String
  category     String
  score        Int
  createdAt    DateTime @default(now())

  @@index([analysisId])
  @@map("discovered_questions")
}

model AITestResult {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questionId     String?
  question       String
  platform       String
  brandMentioned Boolean
  position       Int?
  sentiment      String?
  context        String?
  fullResponse   String?
  citations      String[]
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@index([platform])
  @@map("ai_test_results")
}

model DetectedCompetitor {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  competitorName String
  domain         String?
  overlapScore   Float
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@map("detected_competitors")
}

model AIInsight {
  id               String   @id @default(cuid())
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category         String
  priority         Int
  title            String
  finding          String
  dataEvidence     String
  aiReasoning      String
  actions          String[]
  expectedImpact   Json
  effort           String
  timeline         String
  confidence       String
  correlationScore Int?
  createdAt        DateTime @default(now())

  @@index([analysisId])
  @@index([category])
  @@map("ai_insights")
}
