generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  analyses  Analysis[]
  projects  Project[]
}

model Analysis {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  brandOrKeyword       String
  domain               String?
  competitors          String[]
  status               String                @default("pending")
  progress             Int                   @default(0)
  currentStep          String?
  createdAt            DateTime              @default(now())
  completedAt          DateTime?
  discoveredQuestions  DiscoveredQuestion[]
  aiTestResults        AITestResult[]
  detectedCompetitors  DetectedCompetitor[]
  aiInsights           AIInsight[]

  @@index([userId])
  @@index([status])
  @@map("analyses")
}

model DiscoveredQuestion {
  id           String   @id @default(cuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  question     String
  searchVolume Int
  difficulty   Int
  intent       String
  category     String
  score        Int
  createdAt    DateTime @default(now())

  @@index([analysisId])
  @@map("discovered_questions")
}

model AITestResult {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questionId     String?
  question       String
  platform       String
  brandMentioned Boolean
  position       Int?
  sentiment      String?
  context        String?
  fullResponse   String?
  citations      String[]
  sources        Json?    // Detailed source citations with url, title, domain
  hasGrounding   Boolean  @default(false) // Whether response has verifiable sources
  isRealAPI      Boolean  @default(true)  // Whether this was from real API (not simulated)
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@index([platform])
  @@map("ai_test_results")
}

model DetectedCompetitor {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  competitorName String
  domain         String?
  overlapScore   Float
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@map("detected_competitors")
}

model AIInsight {
  id               String   @id @default(cuid())
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category         String
  priority         Int
  title            String
  finding          String
  dataEvidence     String
  aiReasoning      String
  actions          String[]
  expectedImpact   Json
  effort           String
  timeline         String
  confidence       String
  correlationScore Int?
  createdAt        DateTime @default(now())

  @@index([analysisId])
  @@index([category])
  @@map("ai_insights")
}

// Forma & Attention Models
model Project {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  brandName        String
  websiteUrl       String?
  industry         String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessments      Assessment[]

  @@index([userId])
  @@map("projects")
}

model Assessment {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Overall BSOS
  bsosScore             Float    @default(0)
  
  // Website/Blog Component (0-33)
  websiteScore          Float    @default(0)
  websiteBiasScore      Float    @default(0)
  websiteChoiceScore    Float    @default(0)
  websiteJourneyScore   Float    @default(0)
  
  // Social Media Component (0-33)
  socialScore           Float    @default(0)
  socialContentScore    Float    @default(0)
  socialTriggersScore   Float    @default(0)
  socialVisualScore     Float    @default(0)
  
  // Paid Advertising Component (0-34)
  adScore               Float    @default(0)
  adCreativeScore       Float    @default(0)
  adPersuasionScore     Float    @default(0)
  adLandingScore        Float    @default(0)
  
  // Assessment Data (JSON)
  websiteData           Json?
  socialData            Json?
  adData                Json?
  
  // Recommendations
  recommendations       Json?
  
  // Status
  status                String   @default("draft")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?

  @@index([projectId])
  @@index([status])
  @@map("assessments")
}
