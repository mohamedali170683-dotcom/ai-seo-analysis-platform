generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  createdAt        DateTime           @default(now())
  analyses         Analysis[]
  projects         Project[]
  brandGroundTruths BrandGroundTruth[]
}

model Analysis {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  brandOrKeyword       String
  domain               String?
  competitors          String[]
  targetCountry        String?               // ISO country code (US, UK, DE, etc.)
  targetRegion         String?               // Optional region specification
  status               String                @default("pending")
  progress             Int                   @default(0)
  currentStep          String?
  createdAt            DateTime              @default(now())
  completedAt          DateTime?
  discoveredQuestions  DiscoveredQuestion[]
  aiTestResults        AITestResult[]
  detectedCompetitors  DetectedCompetitor[]
  aiInsights           AIInsight[]

  @@index([userId])
  @@index([status])
  @@index([targetCountry])
  @@map("analyses")
}

model DiscoveredQuestion {
  id           String   @id @default(cuid())
  analysisId   String
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  question     String
  searchVolume Int
  difficulty   Int
  intent       String
  category     String
  score        Int
  createdAt    DateTime @default(now())

  @@index([analysisId])
  @@map("discovered_questions")
}

model AITestResult {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questionId     String?
  question       String
  platform       String
  brandMentioned Boolean
  position       Int?
  sentiment      String?
  context        String?
  fullResponse   String?
  citations      String[]
  sources        Json?    // Detailed source citations with url, title, domain
  hasGrounding   Boolean  @default(false) // Whether response has verifiable sources
  isRealAPI      Boolean  @default(true)  // Whether this was from real API (not simulated)
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@index([platform])
  @@map("ai_test_results")
}

model DetectedCompetitor {
  id             String   @id @default(cuid())
  analysisId     String
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  competitorName String
  domain         String?
  overlapScore   Float
  createdAt      DateTime @default(now())

  @@index([analysisId])
  @@map("detected_competitors")
}

model AIInsight {
  id               String   @id @default(cuid())
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category         String
  priority         Int
  title            String
  finding          String
  dataEvidence     String
  aiReasoning      String
  actions          String[]
  expectedImpact   Json
  effort           String
  timeline         String
  confidence       String
  correlationScore Int?
  createdAt        DateTime @default(now())

  @@index([analysisId])
  @@index([category])
  @@map("ai_insights")
}

// Forma & Attention Models
model Project {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  brandName        String
  websiteUrl       String?
  industry         String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessments      Assessment[]

  @@index([userId])
  @@map("projects")
}

model Assessment {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Overall BSOS
  bsosScore             Float    @default(0)
  
  // Website/Blog Component (0-33)
  websiteScore          Float    @default(0)
  websiteBiasScore      Float    @default(0)
  websiteChoiceScore    Float    @default(0)
  websiteJourneyScore   Float    @default(0)
  
  // Social Media Component (0-33)
  socialScore           Float    @default(0)
  socialContentScore    Float    @default(0)
  socialTriggersScore   Float    @default(0)
  socialVisualScore     Float    @default(0)
  
  // Paid Advertising Component (0-34)
  adScore               Float    @default(0)
  adCreativeScore       Float    @default(0)
  adPersuasionScore     Float    @default(0)
  adLandingScore        Float    @default(0)
  
  // Assessment Data (JSON)
  websiteData           Json?
  socialData            Json?
  adData                Json?
  
  // Recommendations
  recommendations       Json?
  
  // Status
  status                String   @default("draft")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?

  @@index([projectId])
  @@index([status])
  @@map("assessments")
}

// Misinformation & Hallucination Detection Models
model BrandGroundTruth {
  id                          String                        @id @default(cuid())
  userId                      String
  user                        User                          @relation(fields: [userId], references: [id])

  // Company Information
  companyName                 String
  foundedYear                 Int?
  headquarters                String?
  ceo                         String?
  ceoSince                    Int?
  parentCompany               String?
  publiclyTraded              Boolean                       @default(false)
  stockTicker                 String?
  employeeCount               Int?
  revenue                     String?

  // Additional metadata
  industry                    String?
  description                 String?
  websiteUrl                  String?

  // Relations
  products                    Product[]
  historicalFacts             HistoricalFact[]
  approvedClaims              ApprovedClaim[]
  competitorDifferentiators   CompetitorDifferentiator[]
  hallucinationDetections     HallucinationDetection[]

  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([userId])
  @@index([companyName])
  @@map("brand_ground_truths")
}

model Product {
  id                  String            @id @default(cuid())
  groundTruthId       String
  groundTruth         BrandGroundTruth  @relation(fields: [groundTruthId], references: [id], onDelete: Cascade)

  name                String
  launchYear          Int?
  currentlyAvailable  Boolean           @default(true)
  priceMin            Float?
  priceMax            Float?
  currency            String?
  keyFeatures         String[]
  categories          String[]
  discontinuedYear    Int?
  successorProduct    String?
  description         String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([groundTruthId])
  @@index([name])
  @@map("products")
}

model HistoricalFact {
  id                  String            @id @default(cuid())
  groundTruthId       String
  groundTruth         BrandGroundTruth  @relation(fields: [groundTruthId], references: [id], onDelete: Cascade)

  fact                String
  year                Int
  category            String            // founding, product_launch, acquisition, milestone, leadership
  verificationSource  String?
  description         String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([groundTruthId])
  @@index([category])
  @@map("historical_facts")
}

model ApprovedClaim {
  id                      String            @id @default(cuid())
  groundTruthId           String
  groundTruth             BrandGroundTruth  @relation(fields: [groundTruthId], references: [id], onDelete: Cascade)

  claim                   String
  category                String            // performance, sustainability, safety, comparison, award
  approved                Boolean           @default(true)
  regulatoryRestrictions  String[]
  expirationDate          DateTime?
  verificationSource      String?

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([groundTruthId])
  @@index([category])
  @@map("approved_claims")
}

model CompetitorDifferentiator {
  id                  String            @id @default(cuid())
  groundTruthId       String
  groundTruth         BrandGroundTruth  @relation(fields: [groundTruthId], references: [id], onDelete: Cascade)

  competitor          String
  theirFeature        String
  ourEquivalent       String?
  commonlyConfused    Boolean           @default(false)
  description         String?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([groundTruthId])
  @@index([competitor])
  @@map("competitor_differentiators")
}

model HallucinationDetection {
  id                      String                 @id @default(cuid())
  groundTruthId           String
  groundTruth             BrandGroundTruth       @relation(fields: [groundTruthId], references: [id], onDelete: Cascade)

  // Scan metadata
  scanDate                DateTime               @default(now())
  status                  String                 @default("pending") // pending, in_progress, completed, failed

  // Overall scores
  overallAccuracy         Float?
  adjustedAccuracy        Float?
  riskLevel               String?                // LOW, MEDIUM, HIGH, CRITICAL

  // Per-LLM results
  chatgptAccuracy         Float?
  geminiAccuracy          Float?
  copilotAccuracy         Float?
  perplexityAccuracy      Float?

  // Counts
  totalClaims             Int                    @default(0)
  correctClaims           Int                    @default(0)
  incorrectClaims         Int                    @default(0)
  unverifiableClaims      Int                    @default(0)

  // Relations
  hallucinations          Hallucination[]
  recommendations         Recommendation[]

  createdAt               DateTime               @default(now())
  completedAt             DateTime?

  @@index([groundTruthId])
  @@index([status])
  @@index([scanDate])
  @@map("hallucination_detections")
}

model Hallucination {
  id                  String                  @id @default(cuid())
  detectionId         String
  detection           HallucinationDetection  @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  // LLM and query info
  llm                 String                  // chatgpt, gemini, copilot, perplexity
  query               String

  // Hallucination details
  claimedFact         String
  actualFact          String
  category            String                  // DATE_ERROR, COMPETITOR_CONFUSION, FABRICATION, OUTDATED_INFO, EXAGGERATION, MISATTRIBUTION
  severity            String                  // CRITICAL, HIGH, MEDIUM, LOW
  severityScore       Int

  // Context
  fullContext         String?
  responseSnippet     String?

  // Actions
  status              String                  @default("open") // open, addressed, ignored
  suggestedAction     String?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([detectionId])
  @@index([llm])
  @@index([category])
  @@index([severity])
  @@index([status])
  @@map("hallucinations")
}

model Recommendation {
  id                  String                  @id @default(cuid())
  detectionId         String
  detection           HallucinationDetection  @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  priority            String                  // critical, high, medium, low
  category            String
  title               String
  description         String
  affectedLLMs        String[]
  suggestedContent    String?

  // Tracking
  status              String                  @default("pending") // pending, in_progress, completed, dismissed
  implementedAt       DateTime?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([detectionId])
  @@index([priority])
  @@index([status])
  @@map("recommendations")
}
