  "description": "AI-Powered SEO & Search Visibility Analysis Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --skip-generate --accept-data-loss || true) && next build",
    "build:no-db": "prisma generate && next build",
    "build:with-migrate": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test:api-keys": "tsx scripts/test-api-keys.ts",
    "test:perplexity": "tsx scripts/test-perplexity.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
