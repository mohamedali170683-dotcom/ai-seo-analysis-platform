# Database (Required)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/seo_analysis?schema=public"

# Ahrefs API (Required - for fast question discovery)
AHREFS_API_KEY="your-ahrefs-api-key"

# OpenAI API (Required - for ChatGPT testing)
OPENAI_API_KEY="your-openai-api-key"

# Google Gemini API (Optional - for Gemini testing, can skip for speed)
GEMINI_API_KEY="your-google-gemini-api-key"

# Redis (for job queue and caching)
REDIS_URL="redis://localhost:6379"

# NextAuth (for authentication)
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
