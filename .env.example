# Database (Required)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/seo_analysis?schema=public"

# OpenAI API (Required - for ChatGPT testing and AI analysis)
OPENAI_API_KEY="your-openai-api-key"

# Google Gemini API (Optional - for Gemini platform testing)
# If not provided, Gemini responses will be simulated via OpenAI
GEMINI_API_KEY="your-google-gemini-api-key"

# DataForSEO API (Recommended - for REAL search volume data)
# Sign up at: https://dataforseo.com/ (~$50/month, pay-as-you-go)
# This provides real search volumes for questions
DATAFORSEO_LOGIN="your-dataforseo-login-email"
DATAFORSEO_PASSWORD="your-dataforseo-api-password"

# Ahrefs API (Alternative - for real search volume data)
# If not provided, smart questions will be generated automatically
AHREFS_API_KEY="your-ahrefs-api-key"

# Redis (for job queue and caching - optional for basic usage)
REDIS_URL="redis://localhost:6379"

# NextAuth (for authentication)
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"

# Analysis Configuration (Optional defaults)
# TESTS_PER_PLATFORM=5          # Number of AI queries per platform per question
# QUESTIONS_PER_STAGE=4          # Number of questions per funnel stage
