# Database (Required)
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/seo_analysis?schema=public"

# ============================================
# AI PLATFORM API KEYS
# ============================================

# OpenAI API (Required - for ChatGPT testing)
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.15 per 1M input tokens with gpt-4o-mini
OPENAI_API_KEY="your-openai-api-key"

# Google Gemini API (Recommended - for REAL Gemini testing)
# Get your key at: https://aistudio.google.com/app/apikey
# Cost: Free tier available, then pay-as-you-go
# If not provided, Gemini responses will be simulated via OpenAI
GEMINI_API_KEY="your-google-gemini-api-key"

# Perplexity API (Recommended - for REAL Perplexity testing with web search)
# Get your key at: https://www.perplexity.ai/settings/api
# Cost: ~$0.20 per 1M tokens (includes real-time web search!)
# If not provided, Perplexity responses will be simulated via OpenAI
PERPLEXITY_API_KEY="your-perplexity-api-key"

# NOTE: Microsoft Copilot does NOT have a public API
# Copilot responses are always simulated via OpenAI with a system prompt

# ============================================
# SEARCH DATA APIs (for real question volumes)
# ============================================

# DataForSEO API (Recommended - for REAL search volume data)
# Sign up at: https://dataforseo.com/ (~$50/month, pay-as-you-go)
# This provides real search volumes for questions
DATAFORSEO_LOGIN="your-dataforseo-login-email"
DATAFORSEO_PASSWORD="your-dataforseo-api-password"

# Ahrefs API (Alternative - for real search volume data)
# If not provided, smart questions will be generated automatically
AHREFS_API_KEY="your-ahrefs-api-key"

# ============================================
# INFRASTRUCTURE
# ============================================

# Redis (for job queue and caching - optional for basic usage)
REDIS_URL="redis://localhost:6379"

# ============================================
# AUTHENTICATION (Required)
# ============================================

# JWT secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"

# Login credentials
AUTH_USERNAME="your-username"
# Generate hash with: npx tsx -e "import('bcryptjs').then(b => b.hash('yourpassword', 12).then(console.log))"
AUTH_PASSWORD_HASH="$2a$12$your-bcrypt-hash-here"

# NextAuth (optional - for OAuth providers)
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"

# Analysis Configuration (Optional defaults)
# TESTS_PER_PLATFORM=3          # Number of AI queries per platform per question
# QUESTIONS_PER_STAGE=3          # Number of questions per funnel stage
